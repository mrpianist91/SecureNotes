<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notes_list_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".notesListFragment">

    <!-- Empty state dichiarato in XML -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/no_notes"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/fabAddNote"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <!-- Elenco note -->
    <!--
    1) android:clipToPadding="false" dice a un ViewGroup (contenitore: RecyclerView)
     di non ritagliare (clip) il disegno dei figli ai limiti interni definiti dal suo padding.
      Utile per: far vedere ombre/elevation che altrimenti verrebbero troncate,
      permettere ai contenuti scrollabili (es. la prima/ultima cella di una RecyclerView) di scorrere sotto una toolbar o un overlay,
      ottenere effetti di parallax/overlap.
    2) android:layout_marginHorizontal="8dp" imposta lo stesso margine orizzontale su entrambi i lati della view. NB il margine è lo spazio esterno alla view
    3) tools:listitem="@layout/item_note" è un attributo di design-time (solo per l’editor di Android Studio) che dice al Layout Preview quale layout di riga usare per simulare gli elementi della RecyclerView.
     In pratica: l’editor inflata @layout/item_note come item di esempio per mostrarti come apparirà la lista. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotesList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="80dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/fabAddNote"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_note" />

    <!-- Pulsante Aggiungi Nota
         android:src="@android:drawable/ic_input_add" -> ic_input_add è un’icona di sistema (storica, stile Holo)
          che rappresenta l’azione “aggiungi” (il classico “+”).-->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Aggiungi nota"
        android:src="@android:drawable/ic_input_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>