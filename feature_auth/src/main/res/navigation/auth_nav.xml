<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_nav"
    app:startDestination="@id/SplashFragment">

    <!-- ───────── 1. Splash – decide se mostrare onboarding o login ───────── -->
    <fragment
        android:id="@+id/SplashFragment"
        android:name="com.example.securenotes.feature_auth.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">

        <!-- se NON esiste un PIN salvato  -->
        <action
            android:id="@+id/action_splash_to_onBoardingFragment"
            app:destination="@id/onBoardingFragment"
            app:popUpTo="@id/SplashFragment"
            app:popUpToInclusive="true" />

        <!-- se esiste già un PIN  -->
        <action
            android:id="@+id/action_splash_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/SplashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ───────── 2. On-Boarding (slider introduttivo) ───────── -->
    <fragment
        android:id="@+id/onBoardingFragment"
        android:name="com.example.securenotes.feature_auth.OnBoardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding">

        <!-- fine onboarding → crea PIN -->
        <action
            android:id="@+id/action_onBoardingFragment_to_createPinFragment"
            app:destination="@id/createPinFragment" />
    </fragment>

    <!-- ───────── 3. Creazione / modifica PIN ───────── -->
    <fragment
        android:id="@+id/createPinFragment"
        android:name="com.example.securenotes.feature_auth.CreatePinFragment"
        android:label="Crea PIN"
        tools:layout="@layout/fragment_create_pin">

        <!-- primo PIN dopo onboarding → esci dal grafo di auth (e vai alla lista di note) -->
        <action
            android:id="@+id/action_createPinFragment_to_notesListFragment"
            app:destination="@id/createPinFragment"
            app:popUpTo="@id/auth_nav"
            app:popUpToInclusive="true" />
        <!-- modifica PIN (logout forzato) → torna al login -->
        <action
            android:id="@+id/action_createPinFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/auth_nav"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ───────── 4. Login (PIN / biometria) ───────── -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.securenotes.feature_auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_notesListFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/auth_nav"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
