<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_nav"
    app:startDestination="@id/splashFragment"><!--Gli splash screen sono le immagini che appaiono all'avvio di un'app Android-->
    <!--L'effetto combinato di popUpTo e popUpToInclusive, nelle actions dello splashFragment, è che, una volta che l'utente è arrivato
        alla schermata di onboarding o di login, viene rimosso lo splash dal back stack, e quindi una pressione del tasto "indietro" del sistema operativo
        causerà l'uscita dall'applicazione, anziché un ritorno anomalo alla schermata di splash-->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.securenotes.feature_auth.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash" >
        <action
            android:id="@+id/action_splashFragment_to_onboardingHostFragment"
            app:destination="@id/onboardingHostFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/onboardingHostFragment"
        android:name="com.example.securenotes.feature_auth.OnboardingHostFragment"
        android:label="fragment_onboarding_host"
        tools:layout="@layout/fragment_onboarding_host" >
        <action
            android:id="@+id/action_onboardingHostFragment_to_main_app"
            app:destination="@id/notesListFragment"
            app:popUpTo="@id/auth_nav"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.securenotes.feature_auth.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_main_app"
            app:destination="@id/notesListFragment"
            app:popUpTo="@id/auth_nav"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/notesListFragment"
        android:name="com.example.securenotes.feature_notes.NotesListFragment"
        android:label="NotesListFragment" />
</navigation>