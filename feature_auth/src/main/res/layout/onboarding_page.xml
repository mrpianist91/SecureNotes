<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center">

    <!-- ic_lock come esempio -->
    <ImageView
        android:id="@+id/img_onboarding"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/outline_arming_countdown_24"
        app:tint="?attr/colorPrimary"
        android:contentDescription="Illustrazione" />

    <TextView
        android:id="@+id/tv_onboarding_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Titolo slide"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/tv_onboarding_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descrizione della funzionalità o vantaggio dell'app SecureNotes..."
        android:textAlignment="center"
        android:layout_marginTop="8dp"/>
</LinearLayout>
