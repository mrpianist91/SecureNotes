<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="32dp">

    <TextView
        android:id="@+id/tv_create_pin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crea il tuo PIN di accesso"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/et_pin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nuovo PIN"
        android:inputType="numberPassword"
        android:maxLength="10"
        app:layout_constraintTop_toBottomOf="@id/tv_create_pin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/et_confirm_pin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Conferma PIN"
        android:inputType="numberPassword"
        android:maxLength="10"
        app:layout_constraintTop_toBottomOf="@id/et_pin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Barra di robustezza PIN con etichetta -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/strength_bar"
        style="@style/Widget.MaterialComponents.LinearProgressIndicator"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="16dp"
        android:progress="0"
        android:trackThickness="8dp"
        app:layout_constraintTop_toBottomOf="@id/et_confirm_pin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/tv_strength_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Robustezza: "
        app:layout_constraintBaseline_toTopOf="@id/strength_bar"
        app:layout_constraintStart_toStartOf="@id/strength_bar"
        android:paddingTop="16dp"/>

    <Button
        android:id="@+id/btn_create_pin"
        style="?attr/materialButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Conferma PIN"
        app:layout_constraintTop_toBottomOf="@id/strength_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
