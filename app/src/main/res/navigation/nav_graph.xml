<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/auth_nav">

    <!-- Include il grafo di navigazione del modulo di autenticazione -->
    <include app:graph="@navigation/auth_nav" />

    <!-- Schermata Lista Note (destinazione principale post-login) -->
    <fragment
        android:id="@+id/notesListFragment"
        android:name="com.example.securenotes.feature_notes.notesListFragment"
        android:label="Note"
        tools:layout="@layout/fragment_notes_list">
        <!-- Esempio di azioni verso altre feature (Vault, Settings) -->
        <action
            android:id="@+id/action_notesListFragment_to_vaultFragment"
            app:destination="@id/vaultFragment" />
        <action
            android:id="@+id/action_notesListFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>



    <!-- Altre destinazioni principali (Vault, Settings, ecc.) -->
    <fragment
        android:id="@+id/vaultFragment"
        android:name="com.example.securenotes.vaultFragment"
        android:label="Vault"
        tools:layout="@layout/fragment_vault" />
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.securenotes.settingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
